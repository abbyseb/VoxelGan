<mxfile host="app.diagrams.net" modified="2026-08-10T00:00:00.000Z" agent="Voxel_GAN" version="22.1.0" type="device">
  <diagram id="bottleneck" name="UNetFiLM Bottleneck">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="UNetFiLM Bottleneck — one stage, two ConvBlocks (bot1, bot2) + FiLM&#xa;utilities/generator.py · deepest scale = 8³ × 256" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="50" as="geometry"/>
        </mxCell>

        <!-- READ 8^3 -->
        <mxCell id="read" value="How to read 8³&#xa;&#xa;8³ = 8 × 8 × 8  (D × H × W)&#xa;Total voxels = 512&#xa;&#xa;Same notation:&#xa;128³ = full CT/DVF&#xa;64³ = train patches&#xa;8³ = bottleneck grid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;align=left;spacingLeft=12;fontStyle=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="220" height="200" as="geometry"/>
        </mxCell>

        <!-- CONTEXT: where in U-Net -->
        <mxCell id="ctx_lab" value="Where it sits in the U-Net" style="text;html=1;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="720" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="enc4" value="enc4 (Down)&#xa;128 → 256 channels&#xa;16³ → 8³&#xa;anatomy only (no phase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="130" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="enc4" target="bot_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- BOTTLENECK BOX -->
        <mxCell id="bot_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="280" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="bot_lab" value="Bottleneck (one stage)" style="text;html=1;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="115" width="280" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="in_t" value="input tensor&#xa;(B, 256, 8, 8, 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="550" y="150" width="220" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="bot1" value="bot1 = ConvBlock(256 → 256)&#xa;stay at 8³" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="210" width="220" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="bot2" value="bot2 = ConvBlock(256 → 256)&#xa;stay at 8³" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="270" width="220" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="film" value="FiLM (first head, C=256)&#xa;x′ = γ ⊙ x + β&#xa;γ,β ∈ ℝ²⁵⁶  broadcast on 8³&#xa;← first place phases enter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="330" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="a_in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=1.5;" edge="1" parent="1" source="in_t" target="bot1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=1.5;" edge="1" parent="1" source="bot1" target="bot2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_2f" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=1.5;" edge="1" parent="1" source="bot2" target="film">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="dec4" value="dec4 (Up)&#xa;upsample + skip from enc3&#xa;8³ → 16³ · 128 ch&#xa;+ FiLM again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="130" width="170" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="bot_box" target="dec4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- WHY TWO -->
        <mxCell id="why" value="Why bot1 and bot2?&#xa;&#xa;• Not two separate bottlenecks — one stage, two residual ConvBlocks&#xa;• At 8³ the grid is tiny (512 voxels) so extra compute is cheap&#xa;• Two blocks mix coarse features a bit more before FiLM + decode&#xa;• Design choice (capacity), not a hard rule — one block would also work&#xa;&#xa;Flow:&#xa;  enc4 → bot1 → bot2 → FiLM(γ,β) → dec4 …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="440" height="200" as="geometry"/>
        </mxCell>

        <!-- CONVBLOCK DETAIL -->
        <mxCell id="cb_lab" value="Inside one ConvBlock(256→256)" style="text;html=1;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="420" width="510" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="cb_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="450" width="510" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="cb1" value="Conv3³&#xa;256→256&#xa;pad=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5cae9;strokeColor=#3f51b5;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cb2" value="Instance&#xa;Norm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5cae9;strokeColor=#3f51b5;" vertex="1" parent="1">
          <mxGeometry x="650" y="480" width="80" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cb3" value="LeakyReLU&#xa;0.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5cae9;strokeColor=#3f51b5;" vertex="1" parent="1">
          <mxGeometry x="750" y="480" width="80" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cb4" value="Conv3³&#xa;+ IN&#xa;+ LReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5cae9;strokeColor=#3f51b5;" vertex="1" parent="1">
          <mxGeometry x="850" y="480" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cb5" value="+ residual&#xa;(same channels&#xa;→ add input)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9fa8da;strokeColor=#3f51b5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="480" width="50" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e_c1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="1" source="cb1" target="cb2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_c2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="1" source="cb2" target="cb3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_c3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="1" source="cb3" target="cb4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_c4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="1" source="cb4" target="cb5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="cb_note" value="bot1 and bot2 are identical ConvBlocks (in_ch == out_ch = 256).&#xa;Spatial size never changes inside the bottleneck — always 8×8×8.&#xa;Phase conditioning is applied only after both blocks (apply_film)." style="text;html=1;fontSize=11;align=left;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="540" y="560" width="470" height="70" as="geometry"/>
        </mxCell>

        <!-- FILM SOURCE -->
        <mxCell id="film_src" value="γ, β come from FiLMConditioner&#xa;&#xa;phases → Phase-MLP → concat ℝ²⁴&#xa;→ trunk → c ∈ ℝ⁶⁴&#xa;→ head₀: Linear(64 → 512)&#xa;  → Δγ,β each ℝ²⁵⁶&#xa;  → γ = 1 + tanh(Δγ)&#xa;&#xa;See 04_FiLM_Detail_Phases_1_to_6.drawio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="110" width="280" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="code" value="Code path (forward):&#xa;x = enc4(s3)&#xa;x = bot1(x);  x = bot2(x)&#xa;g,b = film_params[0];  x = apply_film(x,g,b)&#xa;x = dec4(x, s3, *film_params[1])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="350" width="280" height="120" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
