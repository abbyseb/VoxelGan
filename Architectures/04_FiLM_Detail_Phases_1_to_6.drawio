        </mxCell>

        <mxCell id="formula" value="FiLM at each scale:&#xa;&#xa;  x′ = γ ⊙ x + β&#xa;&#xa;γ,β broadcast over spatial dims&#xa;(B,C,1,1,1) × (B,C,D,H,W)&#xa;&#xa;γ near 1 = soft scale;&#xa;β = channel-wise shift&#xa;&#xa;Applied AFTER skip fusion&#xa;in decoder (and at bottleneck)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="560" width="360" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="where" value="Where applied for pair 1→6:&#xa;bottleneck 8³×256 · Dec4 16³×128 · Dec3 32³×64 · Dec2 64³×32 · Dec1 128³×16&#xa;Encoder stays unconditioned — only anatomy; phases modulate decode path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="820" height="60" as="geometry"/>
        </mxCell>

        <!-- ========== WORKED SUMMARY ========== -->
        <mxCell id="sum" value="Worked summary for φ=1 → φ=6&#xa;&#xa;1 / 10 = 0.1  →  PhaseMLP  →  e_ref (8)&#xa;6 / 10 = 0.6  →  PhaseMLP  →  e_tgt (8)&#xa;Δe = e_tgt − e_ref&#xa;cat = [e_ref ‖ e_tgt ‖ Δe] ∈ ℝ²⁴&#xa;c = Trunk(cat) ∈ ℝ⁶⁴&#xa;5 heads(c) → {(γ_k, β_k)} for k ∈ {bot, Dec4…Dec1}&#xa;U-Net features at those scales: x ← γ_k ⊙ x + β_k&#xa;→ velocity v → scaling-and-squaring → DVF that warps phase-1 anatomy toward phase-6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;align=left;spacingLeft=12;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1280" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="Note: SPARE files are 1-indexed (CT_01…CT_10). Network uses 0-indexed longs. So “phase 1→6” in SPARE file names is often CT_01→CT_06 → indices 0→5. Diagram uses indices 1 and 6 as a clear numeric example of the math (t=0.1 and 0.6)." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
